# Default: Gemini API (AI Studio key) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here
GOOGLE_GENAI_USE_VERTEXAI=false

# Alternative: Vertex AI (uses ADC: `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional overrides
# NOVAMART_AGENT_MODEL=gemini-2.5-flash
# NOVAMART_JUDGE_MODEL=gemini-2.5-pro
# NOVAMART_ROLE=associate   # or manager
