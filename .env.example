# Default: Gemini API (AI Studio key) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here
GOOGLE_GENAI_USE_VERTEXAI=false

# Alternative: Vertex AI (uses ADC: `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Demo clock: the mock orders in data/orders.json are dated around this day, so the README's
# expected answers ("14 days since delivery") match. Remove it to use the real date.
NOVAMART_TODAY=2026-11-03

# Optional overrides
# NOVAMART_AGENT_MODEL=gemini-3.5-flash
# NOVAMART_JUDGE_MODEL=gemini-3.1-pro-preview
# NOVAMART_ROLE=associate   # or manager
